<Window x:Class="LiveLyricOverlayConfig.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="LiveLyricOverlay 配置 / Settings" Height="680" Width="720"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <GroupBox Header="显示配置 / Display Settings" Padding="10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="字体 / Font:" Width="120" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtFontName" Width="150" IsReadOnly="True" VerticalAlignment="Center"/>
                    <Button Content="..." Width="30" Margin="5,0,20,0" Click="BtnFont_Click"/>
                    <TextBlock Text="主字号:" Width="50" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtFontSize" Width="50" TextChanged="Config_Changed"/>
                    <TextBlock Text="副字号:" Width="50" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtSubFontSize" Width="50" TextChanged="Config_Changed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="未播放 / Main Color:" Width="120" VerticalAlignment="Center"/>
                    <Button x:Name="btnTextColor" Width="60" Height="22" Click="BtnColor_Click" Tag="TextColor"/>
                    <TextBlock Text="至(渐变)" Margin="5,0" VerticalAlignment="Center"/>
                    <Button x:Name="btnTextGradColor" Width="60" Height="22" Click="BtnColor_Click" Tag="TextGradColor"/>
                    
                    <TextBlock Text="已播放 / Highlight:" Width="110" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <Button x:Name="btnHighlightColor" Width="60" Height="22" Click="BtnColor_Click" Tag="HighlightColor"/>
                    <TextBlock Text="至(渐变)" Margin="5,0" VerticalAlignment="Center"/>
                    <Button x:Name="btnHighlightGradColor" Width="60" Height="22" Click="BtnColor_Click" Tag="HighlightGradColor"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <CheckBox x:Name="chkStroke" Content="开启描边 / Stroke" VerticalAlignment="Center" Width="120" Checked="Config_Changed" Unchecked="Config_Changed"/>
                    <TextBlock Text="颜色:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <Button x:Name="btnStrokeColor" Width="60" Height="22" Click="BtnColor_Click" Tag="StrokeColor"/>
                    <TextBlock Text="宽度:" Margin="20,0,5,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtStrokeWidth" Width="50" TextChanged="Config_Changed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <CheckBox x:Name="chkShadow" Content="开启阴影 / Shadow" VerticalAlignment="Center" Width="120" Checked="Config_Changed" Unchecked="Config_Changed"/>
                    <TextBlock Text="颜色:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <Button x:Name="btnShadowColor" Width="60" Height="22" Click="BtnColor_Click" Tag="ShadowColor"/>
                    <TextBlock Text="模糊:" Margin="20,0,5,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtShadowRadius" Width="50" TextChanged="Config_Changed"/>
                    <TextBlock Text="偏移X:" Margin="15,0,5,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtShadowX" Width="40" TextChanged="Config_Changed"/>
                    <TextBlock Text="偏移Y:" Margin="15,0,5,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtShadowY" Width="40" TextChanged="Config_Changed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <CheckBox x:Name="chkKaraoke" Content="开启卡拉OK特效 (Karaoke FX)" VerticalAlignment="Center" Width="200" Checked="Config_Changed" Unchecked="Config_Changed"/>
                    <TextBlock Text="系统语言:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="cmbLanguage" Width="80" SelectionChanged="Config_Changed">
                        <ComboBoxItem Content="zh-CN" Tag="zh-CN"/>
                        <ComboBoxItem Content="en-US" Tag="en-US"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="窗口大小 - 宽:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="txtWinW" Width="50" TextChanged="Config_Changed"/>
                    <TextBlock Text="高:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    <TextBox x:Name="txtWinH" Width="50" TextChanged="Config_Changed"/>
                    <TextBlock Text="默认位置 - X:" VerticalAlignment="Center" Margin="20,0,5,0"/>
                    <TextBox x:Name="txtWinX" Width="50" TextChanged="Config_Changed"/>
                    <TextBlock Text="Y:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    <TextBox x:Name="txtWinY" Width="50" TextChanged="Config_Changed"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="实时预览 / Live Preview" Grid.Row="1" Margin="0,10,0,0">
            <Border BorderBrush="Gray" BorderThickness="1">
               <Grid>
                    <Grid.Background>
                        <DrawingBrush Viewport="0,0,20,20" ViewportUnits="Absolute" TileMode="Tile">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#E0E0E0">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,20,20" />
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="#FFFFFF">
                                        <GeometryDrawing.Geometry>
                                            <GeometryGroup>
                                                <RectangleGeometry Rect="0,0,10,10" />
                                                <RectangleGeometry Rect="10,10,10,10" />
                                            </GeometryGroup>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Grid.Background>
                    <skia:SKElement x:Name="skElement" PaintSurface="OnPaintSurface" />
               </Grid>
            </Border>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="默认配置" Width="80" Margin="0,0,10,0" Click="BtnReset_Click"/>
            <Button Content="应用 / Apply" Width="100" Margin="0,0,10,0" Click="BtnApply_Click" FontWeight="Bold"/>
            <Button Content="确定" Width="80" Margin="0,0,10,0" Click="BtnOk_Click"/>
            <Button Content="取消" Width="80" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
